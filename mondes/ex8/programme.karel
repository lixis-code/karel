# Projet : Karel dans le labyrinthe
#fonction
definir tourner_droite:
    repeter 3 fois:
        tourner_gauche

#programme
tant que pas regarde_sud:
    tourner_gauche
tant que devant_libre:
    avancer
tant que pas regarde_ouest:
    tourner_gauche
tant que devant_libre:
    avancer
tant que pas regarde_nord:
    tourner_gauche
tant que pas balise_ici:
    si gauche_libre:
        tourner_gauche
        avancer
    sinon:
        si devant_bloque:
            tourner_droite
            si devant_bloque:
                tourner_droite
                avancer
        sinon:
            avancer
ramasser_balise